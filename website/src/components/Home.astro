---
import type { ImageMetadata } from 'astro';

import Phone from './Phone.astro';
import DownloadButtons from './DownloadButtons.astro';
import GitHubMark from './GitHubMark.astro';
import { site } from '../site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang];

// Screenshots from apps/trakta_app/test_screenshots (real app, demo data).
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*/*.png', { eager: true });
const shot = (name: string) => shots[`../assets/screenshots/${lang}/${name}.png`].default;

const icons: Record<string, string> = {
  explain:
    'M9 12h6m-6 4h6M7 3h7l5 5v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm7 0v5h5',
  lock: 'M7 11V8a5 5 0 0 1 10 0v3M6 11h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-8a1 1 0 0 1 1-1Zm6 4v2',
  gift: 'M4 11h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-9Zm-1-4h18v4H3V7Zm9 0v14M12 7S10.5 3 8 3a2 2 0 0 0 0 4m4 0s1.5-4 4-4a2 2 0 0 1 0 4',
};
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">{c.hero.eyebrow}</span>
      <h1>{c.hero.title}</h1>
      <p class="lead">{c.hero.lead}</p>
      <DownloadButtons lang={lang} />
      <p class="note">{c.hero.note}</p>
    </div>
    <div class="hero-visual">
      <Phone class="back" src={shot('commuting')} alt={c.features.items[3].alt} eager />
      <Phone class="front" src={shot('overview')} alt={c.features.items[0].alt} eager />
    </div>
  </div>
</section>

<section id="mission" class="section mission">
  <div class="container">
    <div class="section-head">
      <h2>{c.mission.title}</h2>
      <p class="lead">{c.mission.lead}</p>
    </div>
    <div class="pillars">
      {
        c.mission.pillars.map((p) => (
          <article class="card pillar">
            <span class="pillar-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                <path
                  d={icons[p.icon]}
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="features" class="section features">
  <div class="container">
    <div class="section-head">
      <h2>{c.features.title}</h2>
      <p class="lead">{c.features.lead}</p>
    </div>
    {
      c.features.items.map((f, i) => (
        <article class:list={['feature', { flip: i % 2 === 1 }]}>
          <div class="feature-copy">
            <span class="tab">{f.tab}</span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
            <ul>
              {f.points.map((point) => (
                <li>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {point}
                </li>
              ))}
            </ul>
          </div>
          <div class="feature-visual">
            <Phone src={shot(f.key)} alt={f.alt} />
          </div>
        </article>
      ))
    }
  </div>
</section>

<section id="open-source" class="section open-source">
  <div class="container">
    <div class="card source-card">
      <div class="source-copy">
        <h2>{c.openSource.title}</h2>
        <p class="lead">{c.openSource.lead}</p>
      </div>
      <a class="button primary source-button" href={site.repo} rel="noopener">
        <GitHubMark />
        {c.openSource.button}
      </a>
      <ul class="source-points">
        {
          c.openSource.points.map((point) => (
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="m5 12.5 4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section id="about" class="section about">
  <div class="container">
    <div class="card about-card">
      <div>
        <h2>{c.about.title}</h2>
        <p class="lead">{c.about.lead}</p>
        {c.about.text.map((p) => <p>{p}</p>)}
        <div class="about-links">
          <a class="button primary" href={site.linkedIn} rel="noopener" target="_blank">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path
                fill="currentColor"
                d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v6.45h-4v-5.72c0-1.36-.03-3.12-1.9-3.12-1.9 0-2.2 1.49-2.2 3.02v5.82h-4v-11Z"
              />
            </svg>
            {c.about.linkedIn}
          </a>
          <a class="button" href={`mailto:${site.email}`}>{c.about.contact}</a>
        </div>
      </div>
      <div id="support" class="support">
        <h3>{c.support.title}</h3>
        <p>{c.support.text}</p>
        <a class="coffee" href={site.support} rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9Zm12 1h1.5a2.5 2.5 0 0 1 0 5H16M7 3.5c0 1 1 1 1 2s-1 1-1 2m4-4c0 1 1 1 1 2s-1 1-1 2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {c.support.button}
        </a>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="section faq">
  <div class="container narrow">
    <h2>{c.faq.title}</h2>
    {
      c.faq.items.map((item) => (
        <details class="card">
          <summary>{item.q}</summary>
          <p>{item.a}</p>
          {item.link && (
            <p class="faq-link">
              <a href={item.link.href} rel={item.link.href.startsWith('https://') ? 'noopener' : undefined}>
                {item.link.label} →
              </a>
            </p>
          )}
        </details>
      ))
    }
  </div>
</section>

<section class="section cta">
  <div class="container cta-inner">
    <h2>{c.hero.title}</h2>
    <DownloadButtons lang={lang} />
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 40px;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
  }

  .hero-copy .lead {
    max-width: 560px;
    margin-bottom: var(--space-lg);
  }

  .note {
    margin-top: var(--space-md);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    position: relative;
  }

  /* Two phones: the overview in front, the commuting calendar behind. */
  .hero-visual :global(.front) {
    position: relative;
    z-index: 1;
    transform: translateX(14%);
  }

  .hero-visual :global(.back) {
    position: absolute;
    top: 9%;
    left: 50%;
    transform: translateX(-88%) scale(0.86);
    transform-origin: top center;
    opacity: 0.96;
  }

  .hero-visual::before {
    content: '';
    position: absolute;
    inset: 10% -10% 0;
    background: radial-gradient(closest-side, var(--primary-tint), transparent);
    z-index: -1;
  }

  .mission {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .pillar {
    background: var(--background);
  }

  .pillar p {
    color: var(--muted);
    margin: 0;
  }

  .pillar-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--primary-tint);
    color: var(--primary);
    margin-bottom: var(--space-md);
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 40px 0;
  }

  .feature + .feature {
    border-top: 1px solid var(--border);
  }

  .feature.flip .feature-copy {
    order: 2;
  }

  .feature-visual {
    display: flex;
    justify-content: center;
  }

  .tab {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--primary-tint);
    color: var(--primary);
    margin-bottom: var(--space-md);
  }

  .feature-copy h3 {
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: 700;
  }

  .feature-copy p {
    color: var(--muted);
    font-size: 1.05rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }

  li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  li svg {
    flex: none;
    margin-top: 4px;
    color: var(--positive);
  }

  .open-source {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }

  /* Copy and button on the left, the points on the right; on phones the
     button comes last. */
  .source-card {
    background: var(--background);
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    grid-template-areas:
      'copy points'
      'button points';
    column-gap: 48px;
    row-gap: var(--space-sm);
    align-items: center;
    padding: 48px;
    max-width: 960px;
    margin: 0 auto;
  }

  .source-copy {
    grid-area: copy;
  }

  .source-button {
    grid-area: button;
    justify-self: start;
    align-self: start;
  }

  .source-points {
    grid-area: points;
  }

  .about-card {
    padding: 48px;
    max-width: 820px;
    margin: 0 auto;
  }

  .about-card p:not(.lead) {
    color: var(--muted);
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: var(--space-lg);
  }

  /* Support: a quiet block under the about text, with Buy Me a Coffee's
     own yellow on the button so it is recognisable, in the site's font. */
  .support {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .support p {
    color: var(--muted);
    max-width: 620px;
  }

  .coffee {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    border-radius: var(--radius);
    background: #ffdd00;
    color: #0f2942;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.15s;
  }

  .coffee:hover {
    filter: brightness(0.95);
  }

  .narrow {
    max-width: 820px;
  }

  details {
    margin-bottom: 12px;
    padding: 18px 24px;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    color: var(--primary);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1;
  }

  details[open] summary::after {
    content: '–';
  }

  details p {
    margin: 12px 0 0;
    color: var(--muted);
  }

  details .faq-link a {
    font-weight: 500;
  }

  .cta {
    background: var(--navy);
    color: var(--background);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cta h2 {
    max-width: 640px;
    margin-bottom: var(--space-lg);
  }

  /* On the navy band the buttons are inverted, and focus rings use the
     band's text colour so they stay visible. */
  .cta :global(.dl:not(.soon)) {
    background: var(--background);
    border-color: var(--background);
    color: var(--text);
  }

  .cta :global(.dl.soon) {
    background: transparent;
    color: var(--background);
    border-color: color-mix(in srgb, var(--background) 40%, transparent);
  }

  .cta :global(:focus-visible) {
    outline-color: var(--background);
  }

  @media (max-width: 900px) {
    .hero-visual :global(.back) {
      display: none;
    }

    .hero-visual :global(.front) {
      transform: none;
    }

    .hero-grid,
    .feature {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .feature.flip .feature-copy {
      order: 0;
    }

    .pillars {
      grid-template-columns: 1fr;
    }

    .source-card {
      grid-template-columns: 1fr;
      grid-template-areas: 'copy' 'points' 'button';
      row-gap: var(--space-lg);
    }

    .source-copy .lead {
      margin: 0;
    }

    .about-card,
    .source-card {
      padding: 28px;
    }
  }
</style>
