---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A screenshot in a simple, flat phone outline (no device artwork).
interface Props {
  src: ImageMetadata;
  alt: string;
  eager?: boolean;
  class?: string;
}
const { src, alt, eager = false, class: className } = Astro.props;
---

<div class:list={['phone', className]}>
  <Picture
    src={src}
    alt={alt}
    widths={[320, 480, 720]}
    sizes="(max-width: 720px) 72vw, 320px"
    formats={['avif', 'webp']}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</div>

<style>
  .phone {
    width: min(320px, 72vw);
    padding: 10px;
    border-radius: 44px;
    background: var(--navy);
    border: 1px solid var(--border);
    box-shadow: 0 30px 60px -30px rgb(15 41 66 / 0.45);
  }

  @media (prefers-color-scheme: dark) {
    .phone {
      background: #020a12;
      box-shadow: none;
    }
  }

  .phone :global(img) {
    border-radius: 34px;
    width: 100%;
    height: auto;
  }
</style>
