---
import GitHubMark from './GitHubMark.astro';
import { latestRelease } from '../release';
import { site } from '../site';
import { commands, t, type Lang } from '../i18n';

// The download page, in both languages (src/pages/ladda-ner.astro and
// src/pages/en/download.astro). Release info comes from GitHub at build time
// (src/release.ts); without it the button is shown as "coming soon".
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = t[lang].download;

const release = await latestRelease();
const locale = lang === 'sv' ? 'sv-SE' : 'en-GB';
const published = release
  ? new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'Europe/Stockholm' }).format(
      new Date(release.publishedAt),
    )
  : '';
const size = release
  ? new Intl.NumberFormat(locale, { style: 'unit', unit: 'megabyte', maximumFractionDigits: 1 })
      .format(release.sizeBytes / 1_000_000)
      .replace(/\s/g, '\u00a0')
  : '';

// The fingerprint may break after any colon on a narrow phone, never inside a byte,
// and addresses only after a slash.
const fingerprint = site.signingCertSha256.split(':');
const atSlashes = (text: string) => text.split(/(?<=[^/]\/)(?=[^/])/);

const arrow = ' →';
---

<section class="intro">
  <div class="container narrow">
    <h1>{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <p class="beta">
      <span class="pill">{c.beta.label}</span>
      <span>{c.beta.text} <a href={`mailto:${site.email}`}>{site.email}</a>.</span>
    </p>
  </div>
</section>

<div class="container narrow page">
  <section id={c.android.id} class="card android" aria-labelledby="android-title">
    <div class="platform">
      <span class="platform-icon">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
          <path
            d="M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm3 17h2"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
      <h2 id="android-title">{c.android.title}</h2>
    </div>

    {
      release ? (
        <>
          <a class="button primary get" href="/apk" aria-describedby="release-info">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M5 19h14"
              />
            </svg>
            {c.android.button}
          </a>
          <p id="release-info" class="release tabular">
            <span>{`${c.android.version} ${release.version}`}</span> ·{' '}
            <time datetime={release.publishedAt}>{published}</time> · <span>{size}</span>
          </p>
        </>
      ) : (
        <a class="button get soon" role="link" aria-disabled="true">
          {c.android.soon}
        </a>
      )
    }
    <p class="releases">
      <a href={site.releases} rel="noopener">{c.android.releases}{arrow}</a>
    </p>

    <h3>{c.android.stepsTitle}</h3>
    <ol class="steps" role="list">
      {c.android.steps.map((step) => <li>{step}</li>)}
    </ol>
    <p class="note">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path
          d="M12 11v5m0-8.5v.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span>{c.android.note}</span>
    </p>
  </section>

  <section id={c.updates.id} aria-labelledby="updates-title">
    <h2 id="updates-title">{c.updates.title}</h2>
    <p>{c.updates.lead}</p>
    <div class="options">
      {
        c.updates.options.map((option) => (
          <article class="card option">
            <h3>{option.title}</h3>
            <p>{option.text}</p>
            {option.code && (
              <code class="mono block">
                {atSlashes(option.code).map((part, i) => (i ? <><wbr />{part}</> : part))}
              </code>
            )}
            {option.link && (
              <a href={option.link.href} rel="noopener">
                {option.link.label}
                {arrow}
              </a>
            )}
          </article>
        ))
      }
    </div>
    <p>{c.updates.after}</p>
  </section>

  <section id={c.play.id} aria-labelledby="play-title">
    <h2 id="play-title">{c.play.title}</h2>
    <p>{c.play.text}</p>
    <ol class="steps" role="list">
      {c.play.steps.map((step) => <li>{step}</li>)}
    </ol>
  </section>

  <section id={c.iphone.id} aria-labelledby="iphone-title">
    <h2 id="iphone-title">{c.iphone.title}</h2>
    <p>{c.iphone.text}</p>
    <p>
      <a href={site.repo} rel="noopener">{c.iphone.link}{arrow}</a>
    </p>
  </section>

  <section id={c.verify.id} aria-labelledby="verify-title">
    <h2 id="verify-title">{c.verify.title}</h2>
    <p class="muted">{c.verify.lead}</p>
    <p>{c.verify.cert}</p>
    <code class="mono block fingerprint">
      {fingerprint.map((byte, i) => (i < fingerprint.length - 1 ? <>{byte}:<wbr /></> : byte))}
    </code>
    <p>{c.verify.certCheck}</p>
    <code class="mono block">{commands.cert}</code>
    <p>
      {c.verify.sums.before} <a href={site.releases} rel="noopener"><code class="mono">SHA256SUMS.txt</code></a>{' '}
      {c.verify.sums.after}
    </p>
    <p>{c.verify.attest}</p>
    <code class="mono block">{commands.attest}</code>
  </section>

  <section id={c.build.id} aria-labelledby="build-title">
    <h2 id="build-title">{c.build.title}</h2>
    <p>{c.build.text}</p>
    <a class="button" href={site.repo} rel="noopener">
      <GitHubMark />
      {c.build.button}
    </a>
  </section>
</div>

<style>
  .intro {
    padding: 64px 0 var(--space-xl);
  }

  .narrow {
    max-width: 820px;
  }

  h1 {
    font-size: clamp(2.2rem, 5vw, 3rem);
  }

  .intro .lead {
    max-width: 640px;
  }

  .beta {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: var(--space-lg) 0 0;
    padding: 12px var(--space-md);
    border-radius: var(--radius);
    background: var(--subtle);
  }

  .pill {
    flex: none;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--primary-tint);
    color: var(--primary);
    margin-top: 2px;
  }

  .beta a {
    overflow-wrap: anywhere;
  }

  .page {
    padding-bottom: 88px;
  }

  .page > section + section {
    margin-top: 56px;
  }

  .page h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.7rem);
  }

  /* Anchors (#uppdateringar, #verify, …) land below the sticky header. */
  .page section {
    scroll-margin-top: 80px;
  }

  .page p {
    color: color-mix(in srgb, var(--text) 85%, var(--muted));
  }

  .page .muted {
    color: var(--muted);
  }

  .android {
    padding: var(--space-xl);
  }

  .platform {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-lg);
  }

  .platform h2 {
    margin: 0;
  }

  .platform-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--primary-tint);
    color: var(--primary);
  }

  .get {
    min-height: 56px;
    padding: 0 24px;
    font-size: 1.05rem;
    max-width: 100%;
  }

  .get.soon {
    padding: 12px 20px;
    line-height: 1.3;
    text-align: center;
    background: var(--subtle);
    color: var(--muted);
    border-style: dashed;
    cursor: default;
  }

  .get.soon:hover {
    border-color: var(--border);
  }

  .release {
    margin: 12px 0 0;
    font-size: 0.95rem;
  }

  .release > * {
    white-space: nowrap;
  }

  .page .release {
    color: var(--muted);
  }

  .releases {
    margin: 12px 0 0;
  }

  .android h3 {
    margin-top: var(--space-xl);
  }

  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: 0 0 var(--space-lg);
    display: grid;
    gap: 12px;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
    align-items: start;
    color: color-mix(in srgb, var(--text) 85%, var(--muted));
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary-tint);
    color: var(--primary);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .note {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin: 0;
    padding: 12px var(--space-md);
    border-radius: var(--radius);
    background: var(--subtle);
  }

  .note svg {
    flex: none;
    margin-top: 2px;
    color: var(--muted);
  }

  .options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .option {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .option h3 {
    font-size: 1.05rem;
    margin-bottom: var(--space-sm);
  }

  .option p {
    font-size: 0.95rem;
  }

  .option a {
    margin-top: auto;
    font-weight: 500;
  }

  .option .block {
    margin-bottom: var(--space-md);
  }

  /* Monospace for fingerprints, addresses and commands. They wrap anywhere,
     so nothing scrolls sideways on a narrow phone. */
  .mono {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .block {
    display: block;
    width: 100%;
    padding: 10px 14px;
    margin: 0 0 var(--space-md);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--subtle);
    color: var(--text);
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .fingerprint {
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 900px) {
    .options {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .intro {
      padding-top: 40px;
    }

    .android {
      padding: var(--space-lg);
    }

    .get {
      width: 100%;
      justify-content: center;
    }
  }
</style>
