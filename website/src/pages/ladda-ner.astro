---
import Base from '../layouts/Base.astro';
import Download from '../components/Download.astro';
import { site } from '../site';
import { t } from '../i18n';

const c = t.sv.download;
---

<Base lang="sv" title={`${c.meta.title} – ${site.name}`} description={c.meta.description} alternate={t.en.download.href}>
  <Download lang="sv" />
</Base>
